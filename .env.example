# --- Database (Postgres) ---------------------------------------------------
# Use Neon (https://neon.tech), Supabase, Vercel Postgres, or any Postgres 16+.
# DATABASE_URL should be the POOLED connection string (for the app at runtime).
# DIRECT_URL should be the UNPOOLED connection string (for migrations).
# On Neon these are two different connection strings from the same project.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require"

# --- Sessions ----------------------------------------------------------------
# Long random string used to sign admin login sessions. Generate one with:
#   openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-string"

# --- App URL -------------------------------------------------------------
# The public URL of this deployment. Used in emails (links back to the site)
# and the manage/cancel links sent to customers.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Email (optional but recommended) --------------------------------------
# Booking confirmations, reminders, and cancellations are sent via Resend
# (https://resend.com — generous free tier). Without this set, the app still
# works end to end; emails are just logged to the server console instead of
# actually being sent.
RESEND_API_KEY=""
EMAIL_FROM="Your Business <bookings@yourdomain.com>"

# --- Cron ------------------------------------------------------------------
# Protects /api/cron/reminders from being called by anyone but Vercel Cron.
# Generate a random string and set the same value in Vercel's project
# environment variables.
CRON_SECRET="replace-with-a-long-random-string"

# --- Adding businesses (REQUIRED in production) ----------------------------
# Protects /setup — the browser page that creates a business, its admin login
# and its demo data. One deployment serves many businesses, so this page is
# used once per client and stays available; this secret is the ONLY thing
# stopping a stranger from adding businesses to your deployment. Generate a
# long random string and treat it like a password.
SETUP_SECRET="replace-with-a-long-random-string"

# --- Seed data (local dev only) ---------------------------------------------
# Used only by `npm run db:seed`, which creates one demo business per industry
# preset. These credentials become the admin login for the first of them. In
# production use /setup instead — see README.md.
SEED_OWNER_EMAIL="owner@example.com"
SEED_OWNER_PASSWORD="changeme123"
