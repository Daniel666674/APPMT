// Appointment Scheduler — multi-tenant booking platform.
// One deployment serves many businesses; each one lives at /<slug> and owns
// its own staff, services, customers and bookings. Every tenant-owned model
// carries a businessId, and every query is scoped by it.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Business — one tenant. Owns branding, contact info and booking rules.
// Everything needed to re-skin a client's booking page lives here and is
// editable from /admin, not in code.
// ---------------------------------------------------------------------------
model Business {
  id String @id @default(cuid())

  name       String
  slug       String  @unique // the public URL: /<slug>
  logoUrl    String?
  faviconUrl String?

  // Brand kit — drives CSS variables at runtime (see lib/theme.ts)
  primaryColor String @default("#4f46e5")
  accentColor  String @default("#0ea5e9")
  fontFamily   String @default("inter")
  themeMode    String @default("light") // light | dark
  /// sharp | soft | round — drives the corner radius of every card and button.
  cornerStyle  String @default("soft")
  /// Optional photo behind the hero on the booking page.
  heroImageUrl String?

  // Public booking page copy
  heroHeadline    String?
  heroSubheadline String?
  aboutText       String?

  // Contact / footer
  contactEmail String?
  contactPhone String?
  /// Colombian businesses live on WhatsApp; this renders a floating button
  /// on the booking page. Digits only, with country code.
  whatsappNumber String?
  address      String?
  city         String?
  website      String?
  instagramUrl String?
  facebookUrl  String?

  timezone String @default("America/Bogota")
  /// Always COP. Kept as a column so the money formatter has one source of
  /// truth, but it is not editable — this product is sold in Colombia.
  currency String @default("COP")

  // Booking rules
  bookingSlotIntervalMinutes Int     @default(30)
  bookingBufferMinutes       Int     @default(0)
  minNoticeMinutes           Int     @default(120)
  maxAdvanceDays             Int     @default(60)
  requirePhone               Boolean @default(true)
  cancellationWindowHours    Int     @default(24)

  /// Hidden from the public directory at /. Useful for a real client who
  /// shouldn't be listed alongside your sales demos.
  listed Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  staff     Staff[]
  services  Service[]
  customers Customer[]
  bookings  Booking[]
  timeOffs  TimeOff[]

  @@index([listed])
}

enum Role {
  OWNER
  STAFF
}

model User {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(OWNER)

  /// Reseller-level access: can list, enter and edit EVERY business on this
  /// deployment, not just their own. Reserved for whoever runs the platform.
  isPlatformAdmin Boolean @default(false)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  staff Staff?

  @@index([businessId])
}

model Staff {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  name      String
  email     String?
  phone     String?
  bio       String?
  avatarUrl String?
  color     String  @default("#4f46e5")
  active    Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  services       ServiceStaff[]
  availabilities Availability[]
  timeOffs       TimeOff[]
  bookings       Booking[]

  @@index([businessId, active])
}

model Service {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name            String
  description     String?
  durationMinutes Int
  price           Decimal? @db.Decimal(10, 2)
  color           String   @default("#4f46e5")
  active          Boolean  @default(true)
  sortOrder       Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff    ServiceStaff[]
  bookings Booking[]

  @@index([businessId, active])
}

// Which staff members can perform which services (many-to-many). Both sides
// belong to the same business, so this needs no businessId of its own.
model ServiceStaff {
  serviceId String
  staffId   String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  staff     Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@id([serviceId, staffId])
  @@index([staffId])
}

// Recurring weekly working hours per staff member, in business-local time.
// Scoped to a business transitively through Staff.
model Availability {
  id          String @id @default(cuid())
  staffId     String
  staff       Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  dayOfWeek   Int // 0 = Sunday .. 6 = Saturday
  startMinute Int // minutes from midnight, business-local time
  endMinute   Int

  @@index([staffId, dayOfWeek])
}

// One-off overrides: a staff member's day off, a business-wide holiday, or
// shortened hours on a specific date.
model TimeOff {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  staffId     String? // null = applies to the whole business (e.g. a holiday)
  staff       Staff?   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date
  allDay      Boolean  @default(true)
  startMinute Int?
  endMinute   Int?
  reason      String?

  createdAt DateTime @default(now())

  @@index([businessId, date])
  @@index([staffId, date])
}

model Customer {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name  String
  email String
  phone String?
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings Booking[]

  // The same person can be a customer of several businesses.
  @@unique([businessId, email])
  @@index([businessId])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

model Booking {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  serviceId  String
  service    Service  @relation(fields: [serviceId], references: [id])
  staffId    String
  staff      Staff    @relation(fields: [staffId], references: [id])
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  startsAt DateTime // stored in UTC
  endsAt   DateTime

  status BookingStatus @default(CONFIRMED)

  notes         String? // internal, staff-only
  customerNotes String? // submitted by the customer at booking time

  manageToken String @unique @default(cuid()) // lets a customer manage their booking without an account

  cancelledAt  DateTime?
  cancelReason String?

  reminderSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, startsAt])
  @@index([staffId, startsAt])
  @@index([startsAt])
  @@index([status])
  @@index([customerId])
}
